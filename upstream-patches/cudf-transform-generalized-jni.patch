+  // ---------------------------------------------------------------------------------------
+  // Sizes
+  // ---------------------------------------------------------------------------------------
+
+  @Test
+  void zeroRows() {
+    String udf = "__device__ inline void f(int* out, int a, int b) { *out = a + b; }";
+    try (ColumnVector a = ColumnVector.fromInts();
+         ColumnVector b = ColumnVector.fromInts();
+         ColumnVector got = transform(udf, DType.INT32, a, b)) {
+      assertEquals(0, got.getRowCount());
+      assertEquals(DType.INT32, got.getType());
+    }
+  }
+
+  @Test
+  void oneRow() {
+    String udf = "__device__ inline void f(int* out, int a, int b) { *out = a + b; }";
+    try (ColumnVector a = ColumnVector.fromInts(7);
+         ColumnVector b = ColumnVector.fromInts(35);
+         ColumnVector got = transform(udf, DType.INT32, a, b);
+         ColumnVector expected = ColumnVector.fromInts(42)) {
+      assertColumnsAreEqual(expected, got);
+    }
+  }
+
+  @Test
+  void largeBatch() {
+    int n = 1_000_000;
+    long[] a = new long[n];
+    int[] b = new int[n];
+    long[] expectedValues = new long[n];
+    Random rng = new Random(20261122L);
+    for (int i = 0; i < n; i++) {
+      a[i] = rng.nextInt(1_000_000) - 500_000;
+      b[i] = rng.nextInt(1000);
+      expectedValues[i] = a[i] * 2 + b[i];
+    }
+    String udf = "__device__ inline void f(long long* out, long long a, int b) "
+        + "{ *out = a * 2 + (long long)b; }";
+    try (ColumnVector ca = ColumnVector.fromLongs(a);
+         ColumnVector cb = ColumnVector.fromInts(b);
+         ColumnVector got = transform(udf, DType.INT64, ca, cb);
+         ColumnVector expected = ColumnVector.fromLongs(expectedValues)) {
+      assertColumnsAreEqual(expected, got);
+    }
+  }
+
+  @Test
+  void repeatedCallsWithDifferentFunctions() {
+    // Each call compiles a different device function; the JIT cache is keyed on the source,
+    // so this is the case where a stale kernel would show up.
+    try (ColumnVector in = ColumnVector.fromInts(1, 2, 3, 4)) {
+      for (int k = 1; k <= 5; k++) {
+        String udf = "__device__ inline void f(int* out, int a) { *out = a * " + k + "; }";
+        try (ColumnVector got = transform(udf, DType.INT32, in);
+             ColumnVector expected = ColumnVector.fromInts(k, 2 * k, 3 * k, 4 * k)) {
+          assertColumnsAreEqual(expected, got);
+        }
+      }
+      // And back to the first one, which is now a cache hit.
+      try (ColumnVector got = transform(
+               "__device__ inline void f(int* out, int a) { *out = a * 1; }", DType.INT32, in);
+           ColumnVector expected = ColumnVector.fromInts(1, 2, 3, 4)) {
+        assertColumnsAreEqual(expected, got);
+      }
+    }
+  }
+
+  @Test
+  void repeatedExecutionDoesNotLeakDeviceMemory() {
+    String udf = "__device__ inline void f(long long* out, long long a, int b) "
+        + "{ *out = a + (long long)b; }";
+    long[] a = new long[100_000];
+    int[] b = new int[100_000];
+    for (int i = 0; i < a.length; i++) {
+      a[i] = i;
+      b[i] = i % 7;
+    }
+    try (ColumnVector ca = ColumnVector.fromLongs(a);
+         ColumnVector cb = ColumnVector.fromInts(b)) {
+      // Warm up so the JIT compilation and its one-off allocations are not counted.
+      for (int i = 0; i < 3; i++) {
+        transform(udf, DType.INT64, ca, cb).close();
+      }
+      long before = Rmm.getTotalBytesAllocated();
+      for (int i = 0; i < 50; i++) {
+        transform(udf, DType.INT64, ca, cb).close();
+      }
+      long after = Rmm.getTotalBytesAllocated();
+      assertEquals(before, after,
+          "device memory outstanding after 50 closed transforms changed by " + (after - before));
+    }
+  }
+
+  @Test
+  void aFailedCallDoesNotLeakDeviceMemory() {
+    String udf = "__device__ inline void f(int* out, int a, int b) { *out = a + b; }";
+    try (ColumnVector a = ColumnVector.fromInts(1, 2, 3);
+         ColumnVector b = ColumnVector.fromInts(1, 2)) {
+      long before = Rmm.getTotalBytesAllocated();
+      for (int i = 0; i < 20; i++) {
+        assertThrows(CudfException.class, () -> transform(udf, DType.INT32, a, b).close());
+      }
+      assertEquals(before, Rmm.getTotalBytesAllocated());
+    }
+  }
