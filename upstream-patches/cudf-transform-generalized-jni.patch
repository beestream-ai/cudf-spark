+  // ---------------------------------------------------------------------------------------
+  // Errors reported by the device function itself. A non-void return is read as a cudf::errc.
+  // ---------------------------------------------------------------------------------------
+
+  private static final String DIVIDING_UDF =
+      "__device__ inline int f(int* out, int a, int b) {"
+          + "  if (b == 0) { return 2; }"  // cudf::errc::DIVISION_BY_ZERO
+          + "  *out = a / b;"
+          + "  return 0;"                  // cudf::errc::SUCCESS
+          + "}";
+
+  @Test
+  void errorReturningFunctionSucceedsWhenNoRowErrors() {
+    try (ColumnVector a = ColumnVector.fromInts(10, 20, 30);
+         ColumnVector b = ColumnVector.fromInts(2, 4, 5);
+         ColumnVector got = transform(DIVIDING_UDF, DType.INT32, a, b);
+         ColumnVector expected = ColumnVector.fromInts(5, 5, 6)) {
+      assertColumnsAreEqual(expected, got);
+    }
+  }
+
+  @Test
+  void errorReturningFunctionReportsDivisionByZero() {
+    try (ColumnVector a = ColumnVector.fromInts(10, 20, 30);
+         ColumnVector b = ColumnVector.fromInts(2, 0, 5)) {
+      CudfException e = assertThrows(CudfException.class,
+          () -> transform(DIVIDING_UDF, DType.INT32, a, b).close());
+      assertTrue(e.getMessage().contains("DIVISION_BY_ZERO"), e.getMessage());
+    }
+  }
+
+  @Test
+  void errorReturningFunctionReportsOverflow() {
+    String udf = "__device__ inline int f(long long* out, long long a) {"
+        + "  if (a > 1000) { return 1; }"  // cudf::errc::OVERFLOW
+        + "  *out = a;"
+        + "  return 0;"
+        + "}";
+    try (ColumnVector in = ColumnVector.fromLongs(1L, 2L, 5000L)) {
+      CudfException e = assertThrows(CudfException.class,
+          () -> transform(udf, DType.INT64, in).close());
+      assertTrue(e.getMessage().contains("OVERFLOW"), e.getMessage());
+    }
+  }
+
+  @Test
+  void errorReturningFunctionWorksWhenNullAware() {
+    // Error reporting must not be restricted to the null-unaware path.
+    String udf = "__device__ inline int f(cuda::std::optional<int>* out,"
+        + " cuda::std::optional<int> a, cuda::std::optional<int> b) {"
+        + "  if (!a.has_value() || !b.has_value()) { *out = cuda::std::nullopt; return 0; }"
+        + "  if (b.value() == 0) { return 2; }"
+        + "  *out = a.value() / b.value();"
+        + "  return 0;"
+        + "}";
+    try (ColumnVector a = ColumnVector.fromBoxedInts(10, 20, null);
+         ColumnVector b = ColumnVector.fromBoxedInts(2, 4, 0);
+         ColumnVector got = transformNullAware(udf, DType.INT32,
+             OutputNullability.PRESERVE, a, b);
+         ColumnVector expected = ColumnVector.fromBoxedInts(5, 5, null)) {
+      // Row 2 has a null input, so the function returns before dividing: no error.
+      assertColumnsAreEqual(expected, got);
+    }
+    try (ColumnVector a = ColumnVector.fromBoxedInts(10, 20, 30);
+         ColumnVector b = ColumnVector.fromBoxedInts(2, 0, 5)) {
+      CudfException e = assertThrows(CudfException.class,
+          () -> transformNullAware(udf, DType.INT32, OutputNullability.PRESERVE, a, b).close());
+      assertTrue(e.getMessage().contains("DIVISION_BY_ZERO"), e.getMessage());
+    }
+  }
